    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.92.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.5"
