    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.89.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "description": "A simple open-source job tracking application",
  "author": "Rossano Guenci"
