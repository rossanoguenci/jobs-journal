{
  "name": "jobs-journal",
  "version": "0.1.4-alpha",
  "private": true,
  "repository": "github:rossanoguenci/jobs-journal",
  "homepage": "https://github.com/rossanoguenci/jobs-journal",
  "license": "MIT",
  "engines": {
    "node": ">=23.7.0",
    "pnpm": ">=9"
  },
  "type": "module",
  "scripts": {
    "dev": "NEXT_PUBLIC_ENV=development pnpm tauri dev --features dev",
    "dev-no-watcher": "NEXT_PUBLIC_ENV=development pnpm tauri dev --no-watch --features dev",
    "build": "NEXT_PUBLIC_ENV=production pnpm tauri build -- --no-default-features",
    "debug": "RUST_BACKTRACE=full pnpm tauri dev",
    "sync-config": "node scripts/sync-config.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^2.7.8",
    "@internationalized/date": "3.8.0",
    "@react-types/shared": "^3.29.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-fs": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.12.2",
    "geist": "^1.4.2",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^15.3.2",
